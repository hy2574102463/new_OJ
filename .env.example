OJ_ENVIRONMENT=development
OJ_DATABASE_PATH=data/oj.db
OJ_PROBLEMS_PATH=data/problems
OJ_JUDGE_WORKSPACE_PATH=.judge-tmp
OJ_LOG_LEVEL=INFO
OJ_TEST_RESET_ENABLED=false
OJ_SESSION_COOKIE_NAME=oj_session
OJ_SESSION_TTL_SECONDS=86400
OJ_API_BASE_URL=http://127.0.0.1:8000

# OpenAI-compatible API base URL. Keep the real key only in local .env/deployment secrets.
OJ_AI_PROVIDER_URL=https://api.example.com/v1
OJ_AI_MODEL=example-model
OJ_AI_API_KEY=
OJ_AI_INPUT_PRICE=0
OJ_AI_OUTPUT_PRICE=0
OJ_AI_PRICE_UNIT=1000000
OJ_AI_CURRENCY=USD
OJ_AI_REQUEST_TIMEOUT_SECONDS=120
